# Google Sheets integration — see GOOGLE_SHEETS.md for setup instructions

# Email of the Service Account (e.g. my-bot@my-project.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# Private key from the Service Account JSON key file.
# In Vercel: paste the full key including -----BEGIN/END PRIVATE KEY----- lines.
# Newlines are stored as \n literals in the Vercel dashboard — the API handler converts them.
GOOGLE_PRIVATE_KEY=

# ID of the Google Sheet (from the URL: /spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=
